diff --git a/src/WallpaperEngine/Data/Utils/RelaxedJson.h b/src/WallpaperEngine/Data/Utils/RelaxedJson.h
new file mode 100644
index 0000000..282f266
--- /dev/null
+++ b/src/WallpaperEngine/Data/Utils/RelaxedJson.h
@@ -0,0 +1,25 @@
+#pragma once
+#include <string>
+#include <cctype>
+
+namespace WallpaperEngine::Data::Utils {
+// Wallpaper Engine assets permit trailing commas. Preserve positions and all
+// string bytes (including embedded SceneScript) while normalizing that syntax.
+inline std::string stripTrailingCommas (std::string source) {
+    bool quoted = false, escaped = false;
+    for (size_t i = 0; i < source.size (); ++i) {
+        const char ch = source[i];
+        if (quoted) {
+            if (escaped) escaped = false;
+            else if (ch == '\\') escaped = true;
+            else if (ch == '"') quoted = false;
+        } else if (ch == '"') quoted = true;
+        else if (ch == ',') {
+            size_t next = i + 1;
+            while (next < source.size () && std::isspace (static_cast<unsigned char> (source[next]))) ++next;
+            if (next < source.size () && (source[next] == ']' || source[next] == '}')) source[i] = ' ';
+        }
+    }
+    return source;
+}
+}
